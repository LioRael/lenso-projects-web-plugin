{
  "name": "@lenso/projects-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.workspace.config.ts",
    "test": "playwright test",
    "format": "oxfmt --write src tests *.ts *.json *.mjs index.html",
    "format:check": "oxfmt --check src tests *.ts *.json *.mjs index.html",
    "check:assets": "node check-assets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@lenso/tokens": "0.5.0",
    "@lenso/ui": "0.5.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "oxfmt": "0.62.0",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
